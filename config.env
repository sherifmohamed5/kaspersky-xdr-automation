# ==============================================================
#  Kaspersky XDR & KUMA Deployment Configuration File
#  Location: /root/XDR/config.env
# ==============================================================


# Target Installation Directory
TARGET_DIR="/root/XDR"


# --------------------------------------------------------------
# 1. Package Download URLs
# --------------------------------------------------------------
BIN_URL="https://products.s.kaspersky-labs.com/special/XDR/2.2.1.0/multilanguage-INT-2.2.1/635bd328021542028eec0384893ba554/bin.tar.gz"
XDR_TAR_URL="https://products.s.kaspersky-labs.com/special/XDR/2.2.1.0/multilanguage-INT-2.2.1/english-INT/094113e3a30549bba3f77f2111c11581/xdr-2.2.481-en.tar"
PLUGIN_TAR_URL="https://aes.s.kaspersky-labs.com/b2b/KESforWin/14.1.0.6225/multilanguage-INT-6.0.0.6225/3fb2ef27e66f48698b5ebb51cf0b7625/plugin-kesw_14.1.0.6225.tar"
LICENSE_URL="https://box.kaspersky.com/seafhttp/f/51ad5fa5acc14b37bea1/?op=view"


# --------------------------------------------------------------
# 2. Network & Domain Defaults
# --------------------------------------------------------------
# Default Target Host IP (Leave empty to auto-detect from server network interface)
DEFAULT_HOST_IP=""


# Default Ingress IP (Kubernetes Cluster Gateway)
DEFAULT_INGRESS_IP=""


# Default SMP Service Domain Name (console.<domain>, api.<domain>, etc.)
DEFAULT_DOMAIN_NAME="smp.local"


# Default Host Domain Name (Machine FQDN & KUMA inventory services)
DEFAULT_HOST_DOMAIN="XDR.local"


# --------------------------------------------------------------
# 3. Credentials (Optional Preset)
# --------------------------------------------------------------
# If set here, the script will skip interactive password prompting.
# If left empty (""), the script will prompt interactively once with confirmation.
UNIFIED_PASSWORD=""
